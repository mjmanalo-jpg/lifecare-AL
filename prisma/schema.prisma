// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  STAFF
  RESIDENT
  VISITOR
}

enum ResidentStatus {
  ACTIVE
  INACTIVE
  DISCHARGED
  DECEASED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IncidentType {
  FALL
  MEDICATION_ERROR
  BEHAVIORAL
  MEDICAL_EMERGENCY
  SAFETY_HAZARD
  INFECTION
  OTHER
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SEVERE
  CRITICAL
}

enum MessageType {
  GENERAL
  ALERT
  URGENT
  NOTIFICATION
}

enum VitalType {
  BLOOD_PRESSURE
  HEART_RATE
  TEMPERATURE
  OXYGEN_SATURATION
  BLOOD_GLUCOSE
  WEIGHT
  RESPIRATORY_RATE
}

enum MedicationStatus {
  ACTIVE
  DISCONTINUED
  PENDING
  ON_HOLD
}

enum CallBellStatus {
  PENDING
  RESPONDED
  CANCELLED
  RESOLVED
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  OVERNIGHT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNMENT
  VITAL_ALERT
  INCIDENT_REPORT
  MEDICATION_REMINDER
  CALL_BELL
  MESSAGE
  SHIFT_REMINDER
  SYSTEM_ALERT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  password              String
  firstName             String
  lastName              String
  phone                 String?
  role                  UserRole          @default(STAFF)
  avatar                String?
  isActive              Boolean           @default(true)
  lastLogin             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  staff                 Staff?
  sentMessages          Message[]         @relation("SentMessages")
  receivedMessages      Message[]         @relation("ReceivedMessages")
  notifications         Notification[]
  shiftReports          ShiftReport[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@fulltext([firstName, lastName])
}

model Resident {
  id                    String            @id @default(cuid())
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                String
  phone                 String?
  email                 String?
  roomNumber            String
  admissionDate         DateTime
  emergencyContact      String
  emergencyContactPhone String
  medicalHistory        String?
  allergies             String?
  status                ResidentStatus    @default(ACTIVE)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  vitalsLogs            VitalsLog[]
  incidents             Incident[]
  medications           Medication[]
  tasks                 Task[]
  medicalNotes          MedicalNote[]
  callBells             CallBell[]
  visits                Visit[]
  invoices              Invoice[]
  residentNotes         ResidentNote[]

  @@index([email])
  @@index([roomNumber])
  @@index([status])
  @@index([admissionDate])
  @@fulltext([firstName, lastName])
}

model Staff {
  id                    String            @id @default(cuid())
  userId                String            @unique
  position              String
  department            String
  hireDate              DateTime
  license               String?
  licenseExpiry         DateTime?
  supervisor            String?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks         Task[]
  timeTracking          TimeTracking[]
  incidentsReported     Incident[]        @relation("StaffReporter")
  incidentsInvolved     Incident[]        @relation("StaffInvolved")
  shiftReports          ShiftReport[]
  completedTasks        Task[]            @relation("TaskCompletedBy")

  @@index([userId])
  @@index([position])
  @@index([department])
  @@index([isActive])
}

model VitalsLog {
  id                    String            @id @default(cuid())
  residentId            String
  vitalType             VitalType
  value                 String
  unit                  String
  recordedAt            DateTime
  recordedBy            String?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  resident              Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
  @@index([vitalType])
  @@index([recordedAt])
  @@index([residentId, vitalType, recordedAt])
}

model Medication {
  id                    String            @id @default(cuid())
  residentId            String
  name                  String
  dosage                String
  frequency             String
  route                 String
  status                MedicationStatus  @default(ACTIVE)
  startDate             DateTime
  endDate               DateTime?
  prescribedBy          String?
  reason                String?
  sideEffects           String?
  contraindications     String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  resident              Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
  @@index([status])
  @@index([startDate])
}

model Task {
  id                    String            @id @default(cuid())
  residentId            String
  title                 String
  description           String?
  status                TaskStatus        @default(PENDING)
  priority              TaskPriority      @default(MEDIUM)
  assignedToId          String?
  completedById         String?
  dueDate               DateTime
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  resident              Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  assignedTo            Staff?            @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy           Staff?            @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([residentId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([residentId, status])
}

model Incident {
  id                    String            @id @default(cuid())
  residentId            String
  incidentType          IncidentType
  severity              IncidentSeverity
  title                 String
  description           String
  location              String?
  reportedById          String
  involvedStaffIds      String[]
  witnesses             String?
  immediateActions      String?
  followUpRequired      Boolean           @default(false)
  followUpNotes         String?
  incidentDate          DateTime
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  resident              Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  reportedBy            Staff             @relation("StaffReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  involvedStaff         Staff[]           @relation("StaffInvolved")

  @@index([residentId])
  @@index([incidentType])
  @@index([severity])
  @@index([reportedById])
  @@index([incidentDate])
  @@index([followUpRequired])
  @@index([residentId, severity])
}

model MedicalNote {
  id                    String            @id @default(cuid())
  residentId            String
  title                 String
  content               String
  noteType              String
  authorName            String?
  authorRole            String?
  isConfidential        Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  resident              Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
  @@index([createdAt])
  @@index([noteType])
  @@index([isConfidential])
}

model Message {
  id                    String            @id @default(cuid())
  senderId              String
  recipientId           String
  subject               String?
  content               String
  messageType           MessageType       @default(GENERAL)
  isRead                Boolean           @default(false)
  readAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  sender                User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient             User              @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
  @@index([senderId, recipientId])
}

model TimeTracking {
  id                    String            @id @default(cuid())
  staffId               String
  shiftType             ShiftType
  startTime             DateTime
  endTime               DateTime?
  breakDuration        Int?
  status                AttendanceStatus
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  staff                 Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([startTime])
  @@index([shiftType])
  @@index([status])
  @@index([staffId, startTime])
}

model CallBell {
  id                    String            @id @default(cuid())
  residentId            String
  status                CallBellStatus    @default(PENDING)
  reason                String?
  respondedById         String?
  respondedAt           DateTime?
  resolvedAt            DateTime?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  resident              Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
  @@index([status])
  @@index([createdAt])
  @@index([residentId, status])
}

model ShiftReport {
  id                    String            @id @default(cuid())
  staffId               String
  userId                String
  shiftType             ShiftType
  date                  DateTime
  summary               String
  residentUpdates       String?
  incidentsOccurred     Boolean           @default(false)
  incidentDetails       String?
  medicationsAdministered String?
  taskCompleted         String?
  handoverNotes         String?
  signedAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  staff                 Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  user                  User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([staffId])
  @@index([userId])
  @@index([date])
  @@index([shiftType])
  @@index([staffId, date])
}

model Notification {
  id                    String            @id @default(cuid())
  userId                String
  type                  NotificationType
  title                 String
  message               String
  relatedEntityId       String?
  relatedEntityType     String?
  isRead                Boolean           @default(false)
  readAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
}

model Visit {
  id                    String            @id @default(cuid())
  residentId            String
  visitorName           String
  visitorPhone          String?
  relationship          String?
  checkInTime           DateTime
  checkOutTime          DateTime?
  purpose               String?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  resident              Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
  @@index([checkInTime])
  @@index([residentId, checkInTime])
}

model Invoice {
  id                    String            @id @default(cuid())
  residentId            String
  invoiceNumber         String            @unique
  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  totalAmount           Decimal           @db.Decimal(10, 2)
  amountPaid            Decimal           @default(0) @db.Decimal(10, 2)
  dueDate               DateTime
  status                InvoiceStatus     @default(DRAFT)
  description           String?
  notes                 String?
  sentAt                DateTime?
  paidAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  resident              Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceNumber])
  @@index([residentId, status])
}

model ResidentNote {
  id                    String            @id @default(cuid())
  residentId            String
  title                 String
  content               String
  category              String?
  authorName            String?
  isPinned              Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  resident              Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
  @@index([category])
  @@index([isPinned])
  @@index([createdAt])
  @@index([residentId, isPinned])
}
