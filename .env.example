# ============================================
# SUPABASE PostgreSQL DATABASE CONFIGURATION
# ============================================
# NO MS SQL, NO AZURE SQL, ONLY PostgreSQL

# Frontend Database URL (from Supabase)
# Used by Prisma for schema migrations
DATABASE_URL="postgresql://postgres:[password]@[project].supabase.co:5432/postgres?schema=public"

# Direct URL for migrations (non-pooled connection)
# Point to Supabase's direct connection endpoint
DIRECT_URL="postgresql://postgres:[password]@[project].[region].supabase.co:5432/postgres?schema=public"

# Backend Async Database URL
# Used by FastAPI + SQLAlchemy + asyncpg
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:[password]@[project].supabase.co:5432/postgres"

# ============================================
# SUPABASE PROJECT SETTINGS
# ============================================

NEXT_PUBLIC_SUPABASE_URL="https://[project].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-key]"

# ============================================
# BACKEND API SETTINGS
# ============================================

BACKEND_API_URL="http://localhost:8000"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# ============================================
# ENVIRONMENT
# ============================================

NODE_ENV="development"
PYTHON_ENV="development"

# ── Google Gemini [SECRET] ─────────────────────────────────────
GEMINI_API_KEY="AIzaSyARN1l1eE9orrewwA_3E1p6rn--tC71zM8"
GEMINI_MODEL="gemini-2.5-flash"
NANO_BANANA_MODEL="gemini-2.5-flash-image"
NANO_BANANA_PRO_MODEL="gemini-3-pro-image-preview"
# Voice (TTS) — smooth English/Filipino/Taglish voice for all AI assistants.
# Auto-falls back to gemini-2.5-flash-preview-tts if this returns no audio.
GEMINI_TTS_MODEL="gemini-3.1-flash-live-preview"
GEMINI_TTS_VOICE="Kore"

# ============================================
# NOTES
# ============================================
# - Prisma uses DATABASE_URL for queries
# - Prisma uses DIRECT_URL for migrations
# - Backend uses ASYNC_DATABASE_URL for async connections
# - All connections are PostgreSQL via Supabase
# - No SQL Server, no MySQL, no SQLite in production
# - asyncpg driver for high-performance async connections
# - Gemini API key is used SERVER-SIDE only via /api/gemini route
#   (never exposed to the browser client)
