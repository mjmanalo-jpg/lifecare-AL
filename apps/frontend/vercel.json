{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps --include=optional && npm rebuild lightningcss",
  "regions": ["sin1"],
  "crons": [
    { "path": "/api/cron/alerts", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/care-plan-tasks", "schedule": "0 * * * *" },
    { "path": "/api/cron/subscription-reminders", "schedule": "0 8 * * *" },
    { "path": "/api/cron/subscription-lifecycle", "schedule": "0 3 * * *" }
  ]
}
