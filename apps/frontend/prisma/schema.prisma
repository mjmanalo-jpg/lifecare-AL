// Prisma Schema - PostgreSQL via Supabase (NO MS SQL)
// Uses asyncpg for async connections
// Migrations via Prisma CLI

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  role      Role     @default(FAMILY)
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  residents Resident[]

  @@index([role])
  @@index([createdAt])
}

model Resident {
  id           String      @id @default(uuid())
  name         String
  careLevel    CareLevel
  roomNumber   String      @unique
  sponsorId    String
  sponsor      User        @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  vitals       VitalsLog[]
  incidents    Incident[]
  medications  Medication[]
  tasks        Task[]
  medicalNotes MedicalNote[]
  callBells    CallBell[]
  visits       Visit[]
  invoices     Invoice[]
  notes        ResidentNote[]

  @@index([sponsorId])
  @@index([careLevel])
  @@index([createdAt])
}

model VitalsLog {
  id         String   @id @default(uuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type       VitalType
  value      String
  recordedAt DateTime @default(now())
  loggedById String
  createdAt  DateTime @default(now())

  @@index([residentId])
  @@index([recordedAt])
  @@index([type])
  @@unique([residentId, recordedAt])
}

model Incident {
  id           String   @id @default(uuid())
  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type         String
  description  String
  severity     IncidentSeverity @default(NORMAL)
  triggeredAt  DateTime @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([residentId])
  @@index([triggeredAt])
  @@index([severity])
  @@index([createdAt])
}

model Medication {
  id        String   @id @default(uuid())
  name      String
  dosage    String
  frequency String
  route     String   @default("oral")
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId String
  prescribedAt DateTime @default(now())
  prescribedBy String?
  verifiedAt DateTime?
  verifiedBy String?
  startDate DateTime @default(now())
  endDate   DateTime?
  reason    String?
  sideEffects String?
  contraindications String?
  status    MedicationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([prescribedAt])
}

model Task {
  id        String   @id @default(uuid())
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId String
  title     String
  description String?
  status    TaskStatus @default(PENDING)
  assignedTo String?
  dueAt     DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([dueAt])
  @@index([completedAt])
}

model Message {
  id        String   @id @default(uuid())
  from      String
  to        String
  text      String
  status    MessageStatus @default(PENDING)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([from])
  @@index([to])
  @@index([status])
  @@index([createdAt])
}

model Staff {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String
  department String?
  phone     String?
  hireDate  DateTime
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([email])
}

model TimeTracking {
  id        String   @id @default(uuid())
  staffId   String
  clockIn   DateTime
  clockOut  DateTime?
  breakStart DateTime?
  breakEnd  DateTime?
  totalHours Float?
  breakHours Float?
  status    TimeTrackingStatus @default(CLOCKED_IN)
  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([clockIn])
  @@index([status])
}

model MedicalNote {
  id        String   @id @default(uuid())
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId String
  note      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
  @@index([createdAt])
}

model CallBell {
  id        String   @id @default(uuid())
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId String
  status    CallBellStatus @default(ACTIVE)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([residentId])
  @@index([status])
  @@index([createdAt])
}

model ShiftReport {
  id        String   @id @default(uuid())
  staffId   String
  date      DateTime
  tasksCompleted Int @default(0)
  incidents Int @default(0)
  callsResponded Int @default(0)
  avgResponseTime Float?
  engagementScore Int?
  notes     String?
  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([date])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Visit {
  id        String   @id @default(uuid())
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId String
  visitorName String
  visitDate DateTime
  visitType String
  notes     String?
  createdAt DateTime @default(now())

  @@index([residentId])
  @@index([visitDate])
}

model Invoice {
  id        String   @id @default(uuid())
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId String
  amount    Float
  period    String
  status    String   @default("pending")
  issuedAt  DateTime @default(now())
  dueAt     DateTime
  paidAt    DateTime?
  createdAt DateTime @default(now())

  @@index([residentId])
  @@index([status])
  @@index([issuedAt])
}

model ResidentNote {
  id        String   @id @default(uuid())
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId String
  note      String
  createdBy String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
  @@index([createdAt])
}

enum Role { SUPERADMIN, NURSE, CAREGIVER, FAMILY }
enum CareLevel { INDEPENDENT, ASSISTED, MEMORY, SKILLED }
enum VitalType { BLOOD_PRESSURE, HEART_RATE, TEMPERATURE, OXYGEN }
enum MedicationStatus { ACTIVE, PENDING, VERIFIED, DISCONTINUED, HOLD }
enum TaskStatus { PENDING, COMPLETED, CANCELLED }
enum MessageStatus { PENDING, ACKNOWLEDGED, RESOLVED }
enum CallBellStatus { ACTIVE, ACKNOWLEDGED, RESOLVED }
enum IncidentSeverity { NORMAL, HIGH, CRITICAL }
enum ShiftReportStatus { DRAFT, SUBMITTED, REVIEWED }
enum TimeTrackingStatus { CLOCKED_IN, CLOCKED_OUT, ON_BREAK }
