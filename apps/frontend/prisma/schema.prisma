// ============================================================================
// MODELS
// ============================================================================

model User {
  id           String   @id @default(uuid())
  authUserId   String?  @unique
  role         Role     @default(FAMILY)
  platformRole PlatformRole?
  email        String   @unique
  passwordHash String?
  pinHash      String?  // PIN-based login (4-6 digit)
  name         String
  firstName    String?
  lastName     String?
  phone        String?
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  staff             Staff?
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  notifications     Notification[]
  shiftReports      ShiftReport[]
  // A FAMILY user sponsors one or more residents; used to scope the Family portal.
  sponsoredResidents Resident[] @relation("Sponsor")
  // A RESIDENT user is linked 1-1 to their own resident record.
  residentProfile    Resident?  @relation("ResidentSelf")
  organizationMemberships OrganizationMembership[]
  communityMemberships    CommunityMembership[]
  residentAccesses         ResidentAccess[]
  invitationsCreated       Invitation[] @relation("InvitationCreator")

  @@index([role])
  @@index([email])
  @@index([isActive])
  @@index([createdAt])
  @@index([platformRole])
}

model Resident {
  id                  String         @id @default(uuid())
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  gender              String?
  phone               String?
  email               String?
  roomNumber          String
  careLevel           CareLevel
  admissionDate       DateTime
  emergencyContact    String?
  emergencyContactPhone String?
  medicalHistory      String?
  allergies           String?
  notes               String?
  // FAMILY sponsor (nullable — set at move-in). Scopes what a family login can read.
  sponsorId           String?
  sponsor             User?          @relation("Sponsor", fields: [sponsorId], references: [id], onDelete: SetNull)
  // Optional self-login account (RESIDENT role). Scopes a resident to their own record.
  userId              String?        @unique
  residentUser        User?          @relation("ResidentSelf", fields: [userId], references: [id], onDelete: SetNull)

  // V2.1 — Multi-tenant & acuity
  communityId         String?
  community           Community?     @relation(fields: [communityId], references: [id], onDelete: SetNull)
  organizationId      String?
  organization        Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  buildingId          String?
  building            Building?      @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unitId              String?
  unit                Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  currentCarePackageId String?
  currentCarePackage  CarePackage?   @relation(fields: [currentCarePackageId], references: [id], onDelete: SetNull)
  currentAcuityScoreId String?
  currentAcuityLevel  AcuityLevel?
  lastAssessmentDate  DateTime?
  nextAssessmentDue   DateTime?

  // LCMS Module 1 — Extended Demographics
  nationality         String?
  religion            String?
  maritalStatus       MaritalStatus?
  language            String?
  diagnosis           String?
  surgeries           String?         @db.Text
  hospitalizations    String?         @db.Text
  causeOfDeath        String?
  deathDate           DateTime?
  isDeceased          Boolean         @default(false)
  photoUrl            String?

  // LCMS Module 1 — Advance Care Preferences
  advanceDirectives   String?         @db.Text
  dnrStatus           Boolean         @default(false)
  livingWill          String?         @db.Text
  healthcareProxy    String?
  healthcareProxyPhone String?
  codeStatus          String?         @default("FULL_CODE")

  // LCMS Module 2 — Care Dependency
  careDependencyLevel CareDependencyLevel?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  vitals              VitalsLog[]
  incidents           Incident[]
  medications         Medication[]
  tasks               Task[]
  medicalNotes        MedicalNote[]
  callBells           CallBell[]
  visits              Visit[]
  invoices            Invoice[]
  residentNotes       ResidentNote[]
  admission           Admission?     @relation("AdmissionResident")
  serviceCharges      ServiceCharge[]
  insuranceValidations InsuranceValidation[]
  transportRequests   TransportRequest[]
  trips               Trip[]
  goals               ResidentGoal[]
  medicationLogs      MedicationLog[]
  dietitianConsults   DietitianConsult[]
  serviceRequests     ServiceRequest[]
  conciergeBookings   ConciergeBooking[]
  frontDeskVisits     FrontDeskVisit[]
  preferences         ResidentPreference[]
  eventAttendances    EventAttendance[]
  diningReservations  DiningReservation[]
  escalations         Escalation[]
  cameraMonitoringLogs CameraMonitoringLog[]
  assessments         Assessment[]
  acuityScores        AcuityScore[]
  qualityScores       ResidentQualityScore[]
  observations        Observation[]
  // LCMS new relations
  vaccinations        Vaccination[]
  documents           ResidentDocument[]
  woundCares          WoundCare[]
  eliminations        EliminationLog[]
  painAssessments     PainAssessment[]
  sleepLogs           SleepLog[]
  mobilityLogs        MobilityLog[]
  carePlans           CarePlan[]
  hospitalReferrals   HospitalReferral[]
  followUps           FollowUp[]
  careTimeline        CareTimelineEntry[]
  medicationAdministrations MedicationAdministration[]
  dailyRounds            DailyRound[]
  authorizedUsers        ResidentAccess[]
  invitations           Invitation[]

  @@index([careLevel])
  @@index([roomNumber])
  @@unique([communityId, roomNumber])
  @@index([admissionDate])
  @@index([sponsorId])
  @@index([createdAt])
  @@index([communityId])
  @@index([organizationId])
  @@index([currentAcuityLevel])
  @@index([careDependencyLevel])
}

model Staff {
  id            String   @id @default(uuid())
  userId        String   @unique
  position      String
  department    String?
  hireDate      DateTime
  license       String?
  licenseExpiry DateTime?
  isActive      Boolean  @default(true)
  isApproved    Boolean  @default(false)
  avatarUrl     String?
  experience    String?
  documents     Json?

  // V2.1 — Multi-tenant
  communityId   String?
  community     Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreator")
  timeTracking      TimeTracking[]
  incidentsReported Incident[]        @relation("StaffReporter")
  shiftReports      ShiftReport[]
  staffCompetencies StaffCompetency[]

  @@index([userId])
  @@index([position])
  @@index([isActive])
  @@index([communityId])
  @@index([organizationId])
}

// Health monitoring
model VitalsLog {
  id         String   @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type       VitalType
  value      String
  unit       String?
  recordedAt DateTime
  recordedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([residentId])
  @@index([recordedAt])
  @@index([type])
  @@index([residentId, type, recordedAt])

  @@index([organizationId])
  @@index([communityId])
}

model Incident {
  id                  String             @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId          String
  resident            Resident           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  incidentType        IncidentType
  severity            IncidentSeverity
  title               String?
  description         String
  location            String?
  reportedById        String?
  reportedBy          Staff?             @relation("StaffReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  witnesses           String?
  immediateActions    String?
  followUpRequired    Boolean            @default(false)
  followUpNotes       String?
  incidentDate        DateTime
  resolvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([residentId])
  @@index([incidentType])
  @@index([severity])
  @@index([reportedById])
  @@index([incidentDate])

  @@index([organizationId])
  @@index([communityId])
}

model Medication {
  id                String            @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId        String
  resident          Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  name              String
  dosage            String
  frequency         String
  route             String            @default("oral")
  status            MedicationStatus  @default(ACTIVE)
  startDate         DateTime
  endDate           DateTime?
  prescribedBy      String?
  reason            String?
  sideEffects       String?
  contraindications String?
  complianceRecords  MedicationLog[]
  administrations   MedicationAdministration[]
  changeLogs       MedicationChangeLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([startDate])

  @@index([organizationId])
  @@index([communityId])
}

// Resident self-care goals (daily checklist + custom goals)
model ResidentGoal {
  id            String   @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId    String
  resident      Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  isCompleted   Boolean  @default(false)
  isCustom      Boolean  @default(false)
  goalDate      DateTime @default(now())
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([residentId, goalDate])
  @@index([isCompleted])

  @@index([organizationId])
  @@index([communityId])
}

// Medication compliance log (tracks when resident confirms taking medication)
model MedicationLog {
  id            String     @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId    String
  resident      Resident   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  takenAt       DateTime   @default(now())
  // LCMS Module 6 — MAR Status
  marStatus     MARStatus  @default(GIVEN)
  dosage        String?
  route         String?
  refusedReason String?
  heldReason    String?
  witnessId     String?
  witnessName   String?
  notes         String?
  createdAt     DateTime   @default(now())

  @@index([residentId, takenAt])
  @@index([medicationId])
  @@index([marStatus])

  @@index([organizationId])
  @@index([communityId])
}

// Task management
model Task {
  id            String       @id @default(uuid())
  organizationId String?
  residentId    String
  resident      Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        TaskStatus   @default(PENDING)
  priority      TaskPriority @default(MEDIUM)
  assignedToId  String?
  assignedTo    Staff?       @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Who delegated this task (supervisor). Null for self-created caregiver tasks.
  createdById   String?
  createdBy     Staff?       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  dueDate       DateTime
  completedAt   DateTime?

  // V2.1 — Tenant-scoping & care package linking
  communityId   String?
  community     Community?   @relation(fields: [communityId], references: [id], onDelete: SetNull)
  unitId        String?
  unit          Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  serviceCatalogId String?
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  sopId         String?
  recurringPattern Json?
  generatedFrom String?
  documentationRequired String?
  observationId String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdById])
  @@index([dueDate])
  @@index([communityId])

  @@index([organizationId])
}

// Communication
model Message {
  id          String      @id @default(uuid())
  organizationId String?
  communityId    String?
  senderId    String
  sender      User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User        @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String?
  content     String
  messageType MessageType @default(GENERAL)
  isRead      Boolean     @default(false)
  readAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])

  @@index([organizationId])
  @@index([communityId])
}

// Time and attendance
model TimeTracking {
  id             String           @id @default(uuid())
  organizationId String?
  communityId    String?
  staffId        String
  staff          Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftType      ShiftType
  startTime      DateTime
  endTime        DateTime?
  breakDuration  Int?
  status         AttendanceStatus @default(PRESENT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([staffId])
  @@index([startTime])
  @@index([shiftType])
  @@index([status])

  @@index([organizationId])
  @@index([communityId])
}

// Medical notes
model MedicalNote {
  id        String   @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId String
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  // Free-form category: CLINICAL_NOTE, SOAP_NOTE, PROGRESS_NOTE, DIAGNOSIS,
  // DIRECTIVE, CONSULTATION, REFERRAL, CARE_PLAN, etc. (physician + nurse share
  // the MedicalNote model; the type distinguishes the clinical document.)
  noteType  String?
  authorName String?
  isConfidential Boolean @default(false)
  // Physician oversight: co-signing a note (e.g. a nurse's clinical note or a
  // diagnosis) records the reviewing physician and time. Powers the physician's
  // authority perspective over the nurse/caregiver documentation.
  coSignedBy String?
  coSignedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
  @@index([noteType])
  @@index([createdAt])

  @@index([organizationId])
  @@index([communityId])
}

// Emergency system
model CallBell {
  id           String         @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId   String
  resident     Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  status       CallBellStatus @default(PENDING)
  reason       String?
  respondedAt  DateTime?
  resolvedAt   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([createdAt])

  @@index([organizationId])
  @@index([communityId])
}

// Shift reports
model ShiftReport {
  id                    String    @id @default(uuid())
  organizationId String?
  communityId    String?
  staffId               String
  staff                 Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  shiftType             ShiftType
  date                  DateTime
  summary               String?
  residentUpdates       String?
  incidentsOccurred     Boolean   @default(false)
  incidentDetails       String?
  medicationsAdministered String?
  taskCompleted         String?
  handoverNotes         String?
  signedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([staffId])
  @@index([userId])
  @@index([date])
  @@index([shiftType])

  @@index([organizationId])
  @@index([communityId])
}

// Notifications
model Notification {
  id                String           @id @default(uuid())
  organizationId String?
  communityId    String?
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  relatedEntityId   String?
  relatedEntityType String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])

  @@index([organizationId])
  @@index([communityId])
}

// Visits
model Visit {
  id           String   @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  visitorName  String
  visitorPhone String?
  relationship String?
  checkInTime  DateTime
  checkOutTime DateTime?
  purpose      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([residentId])
  @@index([checkInTime])

  @@index([organizationId])
  @@index([communityId])
}

// Billing
model Invoice {
  id                 String        @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId         String
  resident           Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  invoiceNumber      String        @unique
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  totalAmount        Float
  amountPaid         Float         @default(0)
  dueDate            DateTime
  status             InvoiceStatus @default(DRAFT)
  description        String?
  notes              String?
  sentAt             DateTime?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  serviceCharges     ServiceCharge[]
  payments           Payment[]

  @@index([residentId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceNumber])

  @@index([organizationId])
  @@index([communityId])
}

// Resident care notes
model ResidentNote {
  id        String   @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId String
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  category  String?
  authorName String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
  @@index([category])
  @@index([isPinned])
  @@index([createdAt])

  @@index([organizationId])
  @@index([communityId])
}

// ============================================================================
// AI ASSISTANT
// ============================================================================

// Knowledge-base documents for the Super Admin AI Assistant. Uploaded files are
// text-extracted (client-side for text formats, Gemini for binaries) and the
// plain text is stored here for retrieval-augmented chat. Realtime-enabled.
model KnowledgeDoc {
  id        String   @id @default(uuid())
  organizationId String?
  communityId    String?
  name      String
  type      String   @default("unknown")
  size      Int      @default(0)
  chars     Int      @default(0)
  text      String   @db.Text
  source    String   @default("client")
  createdAt DateTime @default(now())

  @@index([createdAt])

  @@index([organizationId])
  @@index([communityId])
}

// Generic key/value application settings (e.g. the assistant's default voice).
// `id` holds the setting key, e.g. "assistantVoice". Realtime-enabled.
model AppSetting {
  id             String        @id
  key            String        @default("")
  value          String        @db.Text
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communityId    String?
  community      Community?    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, communityId, key])
  @@index([organizationId])
  @@index([communityId])
}

// ============================================================================
// ROOM MANAGEMENT
// ============================================================================

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum RoomType {
  PRIVATE
  SEMI_PRIVATE
  WARD
  SUITE
}

model Room {
  id                String     @id @default(uuid())
  organizationId String?
  roomNumber        String
  floor             Int?
  wing              String?
  roomType          RoomType   @default(SEMI_PRIVATE)
  capacity          Int        @default(1)
  status            RoomStatus @default(AVAILABLE)
  // PMS housekeeping lifecycle (mobile staff tools): make ready → inspection →
  // ready → occupied → turnover → move-out → deep clean → (loop).
  housekeepingStatus UnitStatus @default(READY)
  features          String?
  rateMonthly       Float?
  notes             String?

  // V2.1 — Tenant-scoping
  communityId       String?
  community         Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  buildingId        String?
  building          Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floorId           String?
  floorRelation     Floor?     @relation(fields: [floorId], references: [id], onDelete: SetNull)
  unitId            String?
  unit              Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([housekeepingStatus])
  @@index([wing])
  @@index([roomType])
  @@unique([communityId, roomNumber])
  @@index([communityId])
  @@index([buildingId])
  @@index([floorId])
  @@index([unitId])

  @@index([organizationId])
}

// ============================================================================
// V2.1 — MULTI-TENANT HIERARCHY
// ============================================================================

model Organization {
  id             String             @id @default(uuid())
  slug           String?            @unique
  name           String
  legalName      String?
  taxId          String?
  address        String?
  phone          String?
  email          String?
  website        String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  emailFromName  String?
  branding       Json?
  status         OrganizationStatus @default(ACTIVE)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  communities   Community[]
  residents     Resident[]
  staff         Staff[]
  memberships   OrganizationMembership[]
  invitations   Invitation[]
  subscription  Subscription?
  usageSnapshots UsageSnapshot[]
  settings      AppSetting[]

  @@index([isActive])
  @@index([status])
}

model Community {
  id               String        @id @default(uuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  code             String?
  address          String?
  city             String?
  state            String?
  zip              String?
  phone            String?
  email            String?
  timezone         String        @default("America/New_York")
  latitude         Float?
  longitude        Float?
  communityType    CommunityType @default(ASSISTED_LIVING)
  licenseNumber    String?
  licenseExpiry    DateTime?
  bedsTotal        Int?
  bedsAvailable    Int?
  isActive         Boolean       @default(true)
  logoUrl          String?
  primaryColor     String?
  secondaryColor   String?
  configuration    Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  buildings            Building[]
  floors               Floor[]
  units                Unit[]
  staff                Staff[]
  residents            Resident[]
  assessments          Assessment[]
  acuityScores         AcuityScore[]
  carePackages         CarePackage[]
  serviceCatalogs      ServiceCatalog[]
  communitySops        CommunitySop[]
  competencies         Competency[]
  staffingPlans        StaffingPlan[]
  qualityDashboards    CommunityQualityDashboard[]
  kpiRecords           KpiRecord[]
  observations         Observation[]
  tasks                Task[]
  rooms                Room[]
  staffCompetencies    StaffCompetency[]
  residentQualityScores ResidentQualityScore[]
  memberships           CommunityMembership[]
  invitations           Invitation[]
  usageSnapshots        UsageSnapshot[]
  settings              AppSetting[]

  @@index([organizationId])
  @@unique([organizationId, code])
  @@index([communityType])
  @@index([isActive])
}

// ============================================================================
// SAAS IDENTITY, PROVISIONING & ENTITLEMENTS
// ============================================================================

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model CommunityMembership {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  role        Role
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, communityId])
  @@index([communityId, status])
}

model ResidentAccess {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  accessRole Role
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, residentId])
  @@index([residentId, isActive])
}

model Invitation {
  id               String           @id @default(uuid())
  tokenHash        String           @unique
  email            String
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communityId      String?
  community        Community?       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  organizationRole OrganizationRole?
  communityRole    Role?
  residentId       String?
  resident         Resident?        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdById      String?
  createdBy        User?            @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([email, status])
  @@index([residentId])
}

model Plan {
  id                 String   @id @default(uuid())
  key                String   @unique
  name               String
  description        String?
  maxCommunities     Int?
  maxActiveResidents Int?
  maxStaffSeats      Int?
  maxStorageBytes    BigInt?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@index([isActive])
}

model PlanEntitlement {
  id         String  @id @default(uuid())
  planId     String
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  enabled    Boolean @default(true)
  limit      Int?
  config     Json?

  @@unique([planId, featureKey])
}

model Subscription {
  id               String             @id @default(uuid())
  organizationId   String             @unique
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           SubscriptionStatus @default(TRIALING)
  startsAt         DateTime           @default(now())
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  suspendedAt      DateTime?
  canceledAt       DateTime?
  overrides        Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([planId, status])
}

model UsageSnapshot {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communityId    String?
  community      Community?   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  metric         UsageMetric
  value          BigInt
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime     @default(now())

  @@unique([organizationId, communityId, metric, periodStart])
  @@index([organizationId, metric, periodEnd])
}
model Building {
  id          String    @id @default(uuid())
  organizationId String?
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  floorsCount Int       @default(1)
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  floors Floor[]
  rooms  Room[]
  residents Resident[]

  @@index([communityId])

  @@index([organizationId])
}

model Floor {
  id          String    @id @default(uuid())
  organizationId String?
  buildingId  String
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  floorNumber Int
  name        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  units Unit[]
  rooms Room[]

  @@index([buildingId])
  @@index([communityId])

  @@index([organizationId])
}

model Unit {
  id          String           @id @default(uuid())
  organizationId String?
  floorId     String
  floor       Floor            @relation(fields: [floorId], references: [id], onDelete: Cascade)
  communityId String
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  unitType    CommunityUnitType @default(ASSISTED_LIVING)
  capacity    Int              @default(1)
  staffingRatio Json?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rooms  Room[]
  tasks  Task[]
  residents Resident[]
  staffingPlans StaffingPlan[]

  @@index([floorId])
  @@index([communityId])
  @@index([unitType])

  @@index([organizationId])
}

// ============================================================================
// V2.1 — ASSESSMENT & ACUITY ENGINE
// ============================================================================

model Assessment {
  id              String           @id @default(uuid())
  organizationId String?
  residentId      String
  resident        Resident         @relation(fields: [residentId], references: [id], onDelete: Cascade)
  communityId     String
  community       Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  assessmentType  AssessmentType
  version         Int              @default(1)
  status          AssessmentStatus @default(DRAFT)

  adlScore           Int
  cognitionScore     Int
  mobilityScore      Int
  medicalScore       Int
  behavioralScore    Int
  nutritionScore     Int
  hydrationScore     Int
  skinIntegrityScore Int
  socialEngagementScore Int

  totalRawScore      Int
  dimensionCount     Int              @default(9)
  maxPossibleScore   Int

  assessedById       String?
  assessedByName     String
  assessmentTool     String?
  notes              String?          @db.Text
  attachments        Json?

  isReassessment         Boolean      @default(false)
  previousAssessmentId   String?
  reassessmentReason     String?

  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  acuityScore AcuityScore?

  @@index([residentId])
  @@index([communityId])
  @@index([assessmentType])
  @@index([completedAt])
  @@index([residentId, completedAt])

  @@index([organizationId])
}

model AcuityScore {
  id             String      @id @default(uuid())
  organizationId String?
  assessmentId   String      @unique
  assessment     Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  residentId     String
  resident       Resident    @relation(fields: [residentId], references: [id], onDelete: Cascade)
  communityId    String
  community      Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)

  dimensionScores Json
  weightedScore   Float
  normalizedScore Float

  acuityLevel        AcuityLevel
  careLevel          CareLevel
  careLevelConfidence Float?

  dailyCareMinutes Int
  shiftBreakdown   Json
  staffingDemand   Json

  weightsUsed   Json
  weightVersion String

  validFrom  DateTime  @default(now())
  validUntil DateTime?
  isCurrent  Boolean   @default(true)
  scoredAt   DateTime  @default(now())
  scoredById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
  @@index([communityId])
  @@index([acuityLevel])
  @@index([careLevel])
  @@index([isCurrent])
  @@index([validUntil])

  @@index([organizationId])
}

// ============================================================================
// V2.1 — SERVICE CATALOG & CARE PACKAGES
// ============================================================================

model ServiceCatalog {
  id          String          @id @default(uuid())
  organizationId String?
  communityId String
  community   Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  category    ServiceCategory
  description String?
  estimatedMinutes Int        @default(15)
  requiredCompetencies Json?
  suppliesNeeded      Json?
  sopId       String?
  documentationRequired String?
  documentationTemplate String?
  qualityIndicator String?
  monitoringFrequency String?
  billable    Boolean         @default(false)
  baseRate    Float?
  billingCode String?
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  carePackageItems CarePackageItem[]
  tasks            Task[]

  @@index([communityId])
  @@index([category])
  @@index([isActive])

  @@index([organizationId])
