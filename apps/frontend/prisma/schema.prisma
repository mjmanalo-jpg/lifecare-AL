// ============================================================================
// PHASE 6 — FLEET & TRANSPORT MANAGEMENT
// ============================================================================
// Resident transport workflow: request → dispatcher review → vehicle/driver/
// escort assignment → pre-trip inspection → live GPS trip → drop-off → trip log
// → billable ServiceCharge. Plus the maintenance & compliance loop (odometer,
// fuel, insurance/registration alerts, preventive schedule, work orders).

enum VehicleType {
  SHUTTLE
  WHEELCHAIR_VAN
  AMBULANCE
  SEDAN
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  OUT_OF_SERVICE
}

enum TransportRequestType {
  MEDICAL_APPOINTMENT
  DIALYSIS
  THERAPY
  FAMILY_OUTING
  EMERGENCY_TRANSFER
  OTHER
}

enum TransportRequestStatus {
  PENDING
  APPROVED
  SCHEDULED
  DECLINED
  COMPLETED
  CANCELLED
}

enum TransportPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum TripStatus {
  SCHEDULED
  INSPECTION
  EN_ROUTE
  ARRIVED
  RETURNING
  COMPLETED
  CANCELLED
}

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  INSPECTION
}

enum MaintenanceStatus {
  SCHEDULED
  OPEN
  IN_PROGRESS
  AWAITING_PARTS
  COMPLETED
  CANCELLED
}

model Vehicle {
  id                    String        @id @default(uuid())
  organizationId String?
