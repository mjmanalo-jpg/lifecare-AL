// ============================================================================
// SBAR CLINICAL ESCALATION
// ============================================================================
// Standardized clinical hand-off: Caregiver/Nurse raise Situation-Background-
// Assessment-Recommendation on a resident; it routes to the Physician (on-call
// Facility Admin if the SLA is breached), who acknowledges, responds with
// orders/recommendation, and resolves. Fully live (Supabase realtime) — the
// physician sees new escalations instantly and the family is notified of the
// outcome. No static data, no localStorage.

enum EscalationPriority {
  ROUTINE   // SLA 4h
  URGENT    // SLA 30m
  EMERGENCY // SLA 5m
}

enum EscalationStatus {
  OPEN         // raised, awaiting acknowledgement
  ACKNOWLEDGED // receiver has seen it
  IN_PROGRESS  // being acted on
  RESOLVED     // closed with a response
  ESCALATED    // SLA breached / bumped to on-call (Facility Admin)
  CANCELLED
}

model Escalation {
  id             String             @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId     String
  resident       Resident           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  // SBAR
  situation      String             @db.Text
  background     String?            @db.Text
  assessment     String?            @db.Text
  recommendation String?            @db.Text
  priority       EscalationPriority @default(URGENT)
  status         EscalationStatus   @default(OPEN)
  // Routing
  raisedBy       String             // clinician name
  raisedByRole   String             // NURSE | CAREGIVER
  assignedToRole String             @default("PHYSICIAN") // PHYSICIAN | FACILITY_ADMIN (on-call)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  // Physician outcome
  response       String?            @db.Text // recommendation / orders back to the team
  resolvedBy     String?
  resolvedAt     DateTime?
  // Optional links to the triggering event
  relatedIncidentId String?
  relatedVitalId    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([priority])
  @@index([assignedToRole])
  @@index([createdAt])

  @@index([organizationId])
  @@index([communityId])
}

// ============================================================
// LCMS MODULE 4 — COMPREHENSIVE DAILY ROUNDS
// ============================================================

enum Shift {
  DAY
  EVENING
  NIGHT
}

enum DailyRoundStatus {
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

enum EdemaSeverity {
  NONE
  TRACE
  MILD
  MODERATE
  SEVERE
  DEEP
}

enum MoodState {
  CALM
  HAPPY
  SAD
  ANXIOUS
  AGITATED
  CONFUSED
  AGGRESSIVE
  WITHDRAWN
  COOPERATIVE
  APATHETIC
}

enum ConcernCategory {
  PHYSICAL
  BEHAVIORAL
  SKIN
  NUTRITION
  HYDRATION
  MOBILITY
  PAIN
  SLEEP
  MEDICATION
  OTHER
}

enum ConcernSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum AppetiteLevel {
  GOOD
  FAIR
  POOR
  REFUSED
  NPO
}

enum AssistanceLevel {
  INDEPENDENT
  SUPERVISED
  MINIMAL
  MODERATE
  MAXIMAL
  DEPENDENT
}

model DailyRound {
  id              String            @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId      String
  resident        Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  caregiverId     String?
  caregiverName   String?
  shift           Shift
  roundDate       DateTime          @db.Date
  startTime       DateTime          @default(now())
  endTime         DateTime?
  status          DailyRoundStatus  @default(IN_PROGRESS)
  generalNotes    String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  bowelRecords    BowelRecord[]
  urineRecords    UrineRecord[]
  edemaRecords    EdemaRecord[]
  concerns        ConcernRecord[]
  painRecords     PainRecord[]
  moodRecords     MoodRecord[]
  sleepRecord     SleepRecord?
  mobilityRecords MobilityRecord[]
  mealRecords     MealRecord[]
  vitalSigns      VitalSigns[]

  @@index([residentId])
  @@index([roundDate])
  @@index([shift])
  @@index([status])
  @@index([residentId, roundDate, shift])

  @@index([organizationId])
  @@index([communityId])
}

model BowelRecord {
  id              String     @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId    String
  dailyRound      DailyRound @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  time            DateTime
  bristolType     Int?
  consistency     String?
  color           String?
  amount          String?
  hasMucus        Boolean    @default(false)
  hasBlood        Boolean    @default(false)
  odor            String?
  containment     String?
  notes           String?
  createdAt       DateTime   @default(now())

  @@index([dailyRoundId])
  @@index([time])

  @@index([organizationId])
  @@index([communityId])
}

model UrineRecord {
  id              String     @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId    String
  dailyRound      DailyRound @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  time            DateTime
  color           String?
  clarity         String?
  volume          String?
  estimatedMl     Int?
  hasBlood        Boolean    @default(false)
  odor            String?
  urgency         String?
  containment     String?
  outputMl        Int?
  notes           String?
  createdAt       DateTime   @default(now())

  @@index([dailyRoundId])
  @@index([time])

  @@index([organizationId])
  @@index([communityId])
}

model EdemaRecord {
  id              String     @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId    String
  dailyRound      DailyRound @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  time            DateTime
  location        String
  severity        EdemaSeverity
  pitting         Boolean    @default(false)
  skinColor       String?
  skinTemperature String?
  notes           String?
  createdAt       DateTime   @default(now())

  @@index([dailyRoundId])
  @@index([location])

  @@index([organizationId])
  @@index([communityId])
}

model ConcernRecord {
  id              String          @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId    String
  dailyRound      DailyRound      @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  time            DateTime
  category        ConcernCategory
  description     String
  severity        ConcernSeverity
  status          String          @default("OPEN")
  actionTaken     String?
  escalatedTo     String?
  createdAt       DateTime        @default(now())

  @@index([dailyRoundId])
  @@index([category])
  @@index([severity])

  @@index([organizationId])
  @@index([communityId])
}

model PainRecord {
  id                  String     @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId        String
  dailyRound          DailyRound @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  time                DateTime
  location            String
  score               Int
  type                String?
  duration            String?
  triggers            String?
  reliefActions       String?
  medicationGiven     String?
  medicationResponse  String?
  notes               String?
  createdAt           DateTime   @default(now())

  @@index([dailyRoundId])
  @@index([score])

  @@index([organizationId])
  @@index([communityId])
}

model MoodRecord {
  id               String     @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId     String
  dailyRound       DailyRound @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  time             DateTime
  mood             MoodState
  behaviorNotes    String?
  socialEngagement String?
  cooperation      String?
  communication    String?
  triggers         String?
  interventions    String?
  notes            String?
  createdAt        DateTime   @default(now())

  @@index([dailyRoundId])
  @@index([mood])

  @@index([organizationId])
  @@index([communityId])
}

model SleepRecord {
  id                   String     @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId         String     @unique
  dailyRound           DailyRound @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  bedtime              DateTime?
  wakeTime             DateTime?
  totalHours           Float?
  quality              SleepQuality
  interruptions        Int        @default(0)
  interruptionReason   String?
  naps                 Int        @default(0)
  napDuration          String?
  medicationUsed       String?
  positionalChanges    String?
  notes                String?
  createdAt            DateTime   @default(now())

  @@index([dailyRoundId])
  @@index([quality])

  @@index([organizationId])
  @@index([communityId])
}

model MobilityRecord {
  id                String     @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId      String
  dailyRound        DailyRound @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  time              DateTime
  activityType      String
  assistanceLevel   AssistanceLevel
  assistiveDevice   String?
  durationMinutes   Int?
  distance          String?
  gaitPattern       String?
  fallOccurred      Boolean    @default(false)
  fallCircumstances String?
  transferFrom      String?
  transferTo        String?
  notes             String?
  createdAt         DateTime   @default(now())

  @@index([dailyRoundId])
  @@index([activityType])
  @@index([fallOccurred])

  @@index([organizationId])
  @@index([communityId])
}

model MealRecord {
  id              String     @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId    String
  dailyRound      DailyRound @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  time            DateTime
  mealType        MealType
  appetite        AppetiteLevel
  intakeLevel     String
  fluidIntake     String?
  fluidAmountMl   Int?
  foodRefusals    String?
  textureDiet     String?
  supplements     String?
  feedingAssist   String?
  chokingRisk     Boolean    @default(false)
  notes           String?
  createdAt       DateTime   @default(now())

  @@index([dailyRoundId])
  @@index([mealType])

  @@index([organizationId])
  @@index([communityId])
}

model VitalSigns {
  id              String     @id @default(uuid())
  organizationId String?
  communityId    String?
  dailyRoundId    String
  dailyRound      DailyRound @relation(fields: [dailyRoundId], references: [id], onDelete: Cascade)
  time            DateTime
  systolic        Int?
  diastolic       Int?
  heartRate       Int?
  temperature     Float?
  temperatureUnit String     @default("F")
  respRate        Int?
  spo2            Int?
  bloodSugarLevel Int?
  weight          Float?
  weightUnit      String     @default("lbs")
  painScore       Int?
  notes           String?
  createdAt       DateTime   @default(now())

  @@index([dailyRoundId])
  @@index([time])

  @@index([organizationId])
  @@index([communityId])
}

// ─────────────────────────────────────────────────────────────
// Guard / Security module — guard shift logs, patrol notes, and
// incident reports (e.g. a resident seen near the gate). Scalar
// FKs (like CameraMonitoringLog) keep the model self-contained.
// ─────────────────────────────────────────────────────────────
model SecurityLog {
  id             String   @id @default(uuid())
  organizationId String?
  communityId    String?
  guardStaffId   String?
  guardName      String?
  logType        String   @default("PATROL") // PATROL | INCIDENT | GATE_EVENT | VISITOR | HAZARD
  title          String
  description    String?  @db.Text
  location       String?
  severity       String   @default("MINOR")  // MINOR | MODERATE | SEVERE | CRITICAL
  residentId     String?
  residentName   String?
  status         String   @default("OPEN")   // OPEN | RESOLVED
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([communityId])
  @@index([organizationId])
  @@index([logType])
  @@index([occurredAt])
}

// ─────────────────────────────────────────────────────────────
// Kitchen / Diet & Nutrition — per-resident standing diet orders
// set by the nutritionist. The kitchen reads today's active orders
// as its "cook list" (low sodium / low sugar / more vegetables / …).
// ─────────────────────────────────────────────────────────────
model DietOrder {
  id             String   @id @default(uuid())
  organizationId String?
  communityId    String?
  residentId     String?
  residentName   String?
  roomNumber     String?
  dietType       String   @default("REGULAR") // REGULAR | LOW_SODIUM | LOW_SUGAR | DIABETIC | SOFT | PUREED | HIGH_FIBER | RENAL | HIGH_PROTEIN
  restrictions   String?  // free text, e.g. "no nuts, no shellfish"
  mealType       String   @default("ALL")     // ALL | BREAKFAST | LUNCH | DINNER | SNACK
  notes          String?  @db.Text
  active         Boolean  @default(true)
  orderedBy      String?  // nutritionist name
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([communityId])
  @@index([organizationId])
  @@index([residentId])
  @@index([active])
}
