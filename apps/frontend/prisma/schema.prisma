  status          TransportRequestStatus @default(PENDING)
  source          String                 @default("PORTAL") // PORTAL | AI_COMPANION | FRONT_DESK
  notes           String?
  reviewedBy      String?
  reviewedAt      DateTime?
  declineReason   String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  trip Trip?

  @@index([residentId])
  @@index([status])
  @@index([priority])
  @@index([requestedDate])

  @@index([organizationId])
  @@index([communityId])
}

model Trip {
  id                  String            @id @default(uuid())
  organizationId String?
  communityId    String?
  requestId           String?           @unique
  request             TransportRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  residentId          String
  resident            Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  vehicleId           String?
  vehicle             Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId            String?
  driver              Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  escortName          String?
  escortRole          String? // NURSE | CAREGIVER
  status              TripStatus        @default(SCHEDULED)
  // pickup → drop-off for this leg; a return leg simply swaps them. origin/
  // destination remain populated (= pickup/drop-off) for backward compatibility.
  pickupLocation      String?
  dropoffLocation     String?
  destination         String
  origin              String            @default("Golden Hearth Facility")
  scheduledAt         DateTime
  departedAt          DateTime?
  arrivedAt           DateTime?
  returnDepartedAt    DateTime?
  completedAt         DateTime?
  distanceKm          Float?
  // Live GPS ping — updated in transit; realtime subscribers re-render the map.
  currentLat          Float?
  currentLng          Float?
  lastPingAt          DateTime?
  inspectionDone      Boolean           @default(false)
  // JSON array of { item: string, ok: boolean } for the pre-trip safety checklist.
  inspectionChecklist String?           @db.Text
  familyNotified      Boolean           @default(false)
  billed              Boolean           @default(false)
  charge              Float?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([residentId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  @@index([scheduledAt])

  @@index([organizationId])
  @@index([communityId])
}

