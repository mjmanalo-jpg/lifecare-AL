// Prisma Schema - PostgreSQL via Supabase
// Complete assisted-living facility management system
// Merged from frontend (canonical) + root schema (structure/enums)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

