// Prisma Schema - PostgreSQL via Supabase
// Complete assisted-living facility management system
// Merged from frontend (canonical) + root schema (structure/enums)

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SUPERADMIN
  NURSE
  CAREGIVER
  FAMILY
}

enum CareLevel {
  INDEPENDENT
  ASSISTED
  MEMORY
  SKILLED
}

enum VitalType {
  BLOOD_PRESSURE
  HEART_RATE
  TEMPERATURE
  OXYGEN
  BLOOD_GLUCOSE
  WEIGHT
  RESPIRATORY_RATE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IncidentType {
  FALL
  MEDICATION_ERROR
  BEHAVIORAL
  MEDICAL_EMERGENCY
  SAFETY_HAZARD
  INFECTION
  OTHER
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SEVERE
  CRITICAL
}

enum MessageType {
  GENERAL
  ALERT
  URGENT
  NOTIFICATION
}

enum MedicationStatus {
  ACTIVE
  DISCONTINUED
  PENDING
  ON_HOLD
}

enum CallBellStatus {
  PENDING
  RESPONDED
  CANCELLED
  RESOLVED
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  OVERNIGHT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNMENT
  VITAL_ALERT
  INCIDENT_REPORT
  MEDICATION_REMINDER
  CALL_BELL
  MESSAGE
  SHIFT_REMINDER
  SYSTEM_ALERT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id        String   @id @default(uuid())
  role      Role     @default(FAMILY)
  email     String   @unique
  name      String
  firstName String?
  lastName  String?
  phone     String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  staff             Staff?
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  notifications     Notification[]
  shiftReports      ShiftReport[]

  @@index([role])
  @@index([email])
  @@index([isActive])
  @@index([createdAt])
}

model Resident {
  id                  String         @id @default(uuid())
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  gender              String?
  phone               String?
  email               String?
  roomNumber          String         @unique
  careLevel           CareLevel
  admissionDate       DateTime
  emergencyContact    String?
  emergencyContactPhone String?
  medicalHistory      String?
  allergies           String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  vitals              VitalsLog[]
  incidents           Incident[]
  medications         Medication[]
  tasks               Task[]
  medicalNotes        MedicalNote[]
  callBells           CallBell[]
  visits              Visit[]
  invoices            Invoice[]
  residentNotes       ResidentNote[]

  @@index([careLevel])
  @@index([roomNumber])
  @@index([admissionDate])
  @@index([createdAt])
}

model Staff {
  id            String   @id @default(uuid())
  userId        String   @unique
  position      String
  department    String?
  hireDate      DateTime
  license       String?
  licenseExpiry DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks     Task[]
  timeTracking      TimeTracking[]
  incidentsReported Incident[]        @relation("StaffReporter")
  shiftReports      ShiftReport[]

  @@index([userId])
  @@index([position])
  @@index([isActive])
}

// Health monitoring
model VitalsLog {
  id         String   @id @default(uuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type       VitalType
  value      String
  unit       String?
  recordedAt DateTime
  recordedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([residentId])
  @@index([recordedAt])
  @@index([type])
  @@index([residentId, type, recordedAt])
}

model Incident {
  id                  String             @id @default(uuid())
  residentId          String
  resident            Resident           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  incidentType        IncidentType
  severity            IncidentSeverity
  title               String?
  description         String
  location            String?
  reportedById        String?
  reportedBy          Staff?             @relation("StaffReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  witnesses           String?
  immediateActions    String?
  followUpRequired    Boolean            @default(false)
  followUpNotes       String?
  incidentDate        DateTime
  resolvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([residentId])
  @@index([incidentType])
  @@index([severity])
  @@index([reportedById])
  @@index([incidentDate])
}

model Medication {
  id                String            @id @default(uuid())
  residentId        String
  resident          Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  name              String
  dosage            String
  frequency         String
  route             String            @default("oral")
  status            MedicationStatus  @default(ACTIVE)
  startDate         DateTime
  endDate           DateTime?
  prescribedBy      String?
  reason            String?
  sideEffects       String?
  contraindications String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([startDate])
}

// Task management
model Task {
  id            String       @id @default(uuid())
  residentId    String
  resident      Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        TaskStatus   @default(PENDING)
  priority      TaskPriority @default(MEDIUM)
  assignedToId  String?
  assignedTo    Staff?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate       DateTime
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([dueDate])
}

// Communication
model Message {
  id          String      @id @default(uuid())
  senderId    String
  sender      User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User        @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String?
  content     String
  messageType MessageType @default(GENERAL)
  isRead      Boolean     @default(false)
  readAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
}

// Time and attendance
model TimeTracking {
  id             String           @id @default(uuid())
  staffId        String
  staff          Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftType      ShiftType
  startTime      DateTime
  endTime        DateTime?
  breakDuration  Int?
  status         AttendanceStatus @default(PRESENT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([staffId])
  @@index([startTime])
  @@index([shiftType])
  @@index([status])
}

// Medical notes
model MedicalNote {
  id        String   @id @default(uuid())
  residentId String
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  noteType  String?
  authorName String?
  isConfidential Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
  @@index([createdAt])
}

// Emergency system
model CallBell {
  id           String         @id @default(uuid())
  residentId   String
  resident     Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  status       CallBellStatus @default(PENDING)
  reason       String?
  respondedAt  DateTime?
  resolvedAt   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([createdAt])
}

// Shift reports
model ShiftReport {
  id                    String    @id @default(uuid())
  staffId               String
  staff                 Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  shiftType             ShiftType
  date                  DateTime
  summary               String?
  residentUpdates       String?
  incidentsOccurred     Boolean   @default(false)
  incidentDetails       String?
  medicationsAdministered String?
  taskCompleted         String?
  handoverNotes         String?
  signedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([staffId])
  @@index([userId])
  @@index([date])
  @@index([shiftType])
}

// Notifications
model Notification {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  relatedEntityId   String?
  relatedEntityType String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

// Visits
model Visit {
  id           String   @id @default(uuid())
  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  visitorName  String
  visitorPhone String?
  relationship String?
  checkInTime  DateTime
  checkOutTime DateTime?
  purpose      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([residentId])
  @@index([checkInTime])
}

// Billing
model Invoice {
  id                 String        @id @default(uuid())
  residentId         String
  resident           Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  invoiceNumber      String        @unique
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  totalAmount        Float
  amountPaid         Float         @default(0)
  dueDate            DateTime
  status             InvoiceStatus @default(DRAFT)
  description        String?
  notes              String?
  sentAt             DateTime?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([residentId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceNumber])
}

// Resident care notes
model ResidentNote {
  id        String   @id @default(uuid())
  residentId String
  resident  Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  category  String?
  authorName String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
  @@index([category])
  @@index([isPinned])
  @@index([createdAt])
}
